    <!-- ===== Main content ===== -->
    <main class="content">

      <section class="col fade-in delay-1" id="vegetables">
        <h2 class="section-title">Vegetables</h2>
        <div class="cards">
          <div class="card">
            <div class="card-img"><img src="images/carrot.png" alt="Carrots"></div>
            <p class="card-text">notosansnotosans</p>
          </div>
          <div class="card">
            <div class="card-img"><img src="images/corn.png" alt="Corn"></div>
            <p class="card-text">notosansnotosans</p>
          </div>
          <div class="card">
            <div class="card-img"><img src="images/pepper.png" alt="Yellow peppers"></div>
            <p class="card-text">notosansnotosans</p>
          </div>
        </div>
